    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "husky:install": "husky install",
        "prebuild": "rimraf lib",
        "build": "tsc -p ./tsconfig.build.json",
        "lint": "eslint \"{src,apps,libs}/**/*.+(js|json|ts|tsx)\" --fix",
